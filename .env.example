# Zoho Catalyst Cloud Scale DB connection string
# Get this from: Catalyst Console → Cloud Scale → CSQL → your database → Connection Details
DATABASE_URL=postgresql://user:password@host:5432/koku

# Zoho Catalyst File Store folder ID for storing encrypted backups
# Get this from: Catalyst Console → Cloud Scale → File Store → your folder → Folder ID
CATALYST_BACKUP_FOLDER_ID=your-folder-id

# AES-256 encryption key (exactly 32 characters) for encrypting backup archives
ENCRYPTION_KEY=32-char-key-for-aes-encryption
