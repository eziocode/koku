# ── Local mode (default for self-hosted installs) ─────────────────────────────
# Set both to "true" for local-only setup, "false" for Catalyst cloud deployment.
LOCAL_MODE=true
NEXT_PUBLIC_LOCAL_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
# Local:  postgresql://koku:koku_password@localhost:5432/koku  (Docker Compose)
# Cloud:  Catalyst Console → Cloud Scale → CSQL → Connection Details
DATABASE_URL=postgresql://koku:koku_password@localhost:5432/koku

# ── Encryption ────────────────────────────────────────────────────────────────
# Any 32-character random string. Generate with: openssl rand -hex 16
ENCRYPTION_KEY=32-char-key-for-aes-encryption

# ── Cloud only (leave blank for local mode) ───────────────────────────────────
# Catalyst Console → Cloud Scale → File Store → your folder → Folder ID
CATALYST_BACKUP_FOLDER_ID=
