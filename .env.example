# ── Local mode (default for self-hosted installs) ─────────────────────────────
# Set both to "true" for local-only setup, "false" for Catalyst cloud deployment.
LOCAL_MODE=true
NEXT_PUBLIC_LOCAL_MODE=true

# ── Cloud only (leave blank for local mode) ───────────────────────────────────
# Catalyst Console → Cloud Scale → File Store → your folder → Folder ID
CATALYST_BACKUP_FOLDER_ID=

# ── Catalyst SDK (cloud mode) ─────────────────────────────────────────────────
# No credentials needed here — zcatalyst-sdk-node auto-authenticates via
# Catalyst AppSail runtime headers. Just deploy via `catalyst deploy`.
# Auth is handled by /__catalyst/auth/login (Catalyst hosted auth).
